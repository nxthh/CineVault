{
  "name": "cinevault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/input.css -o dist/styles.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o dist/styles.css --watch",
    "build": "tsc && npm run css",
    "dev": "tsc --watch",
    "serve": "serve .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "serve": "^10.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  }
}
